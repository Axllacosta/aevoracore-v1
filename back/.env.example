# PostgreSQL
POSTGRES_DB=aevora
POSTGRES_USER=aevora
POSTGRES_PASSWORD=clave_local_de_ejemplo
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Autenticación
JWT_SECRET_KEY=reemplazar_por_una_clave_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=30

# Orígenes permitidos
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:4201","http://127.0.0.1:4201"]

# MinIO local
MINIO_ROOT_USER=aevora_local
MINIO_ROOT_PASSWORD=clave_minio_de_ejemplo
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_BUCKET=aevora-products
MINIO_REGION=us-east-1

# Administrador inicial opcional. Para crearlo, descomenta y configura ambos valores.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=reemplazar_por_una_clave_unica
